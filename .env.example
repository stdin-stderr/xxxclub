POSTGRES_USER=xxxclub
POSTGRES_PASSWORD=xxxclub
POSTGRES_DB=xxxclub
POSTGRES_HOST_PORT=5432
WEB_HOST_PORT=5000

# Shared application image used by scraper, web, and tpdb-matcher.
XXXCLUB_IMAGE=xxxclub:local

# Comma-separated. All three domains serve the same ID space from one origin, so any
# host can serve any torrent. Start with one; only add the others once the probe in
# PLAN-V3.md §6 says the fan-out is safe (python3 probe_limit.py --compare).
BASE_URLS=https://xxxclub.to
# BASE_URLS=https://xxxclub.to,https://xxxclub.cc,https://xxxclub.me
SITE_TZ=UTC

# Days back the initial backfill walks. Default 30 if unset; start small for a quick first run.
BACKFILL_DAYS=2

# Pacing is per domain; total throughput is this times the number of BASE_URLS.
# Concurrency is not a separate knob: one in-flight request per domain (PLAN-V3.md §1).
#   1    = one request per second per domain
#   0.5  = one request every two seconds per domain
# Minimum 0.01. Startup rejects 0, negatives, inf and nan.
REQUESTS_PER_SECOND_PER_DOMAIN=1

# How long a host is withheld after a 403/429/challenge. Retry-After overrides this
# when the server sends a usable one; both are capped at 15 min.
BLOCK_COOLDOWN_SECONDS=60
REQUEST_TIMEOUT_SECONDS=15

FRONTIER_LOOKAHEAD=500
FRONTIER_DRY_STREAK=200
BACKFILL_CHUNK_SIZE=500
BACKFILL_CONFIRM_WINDOW=100
BACKFILL_SAFETY_MARGIN_IDS=200
RETRY_BATCH_SIZE=200
REFRESH_BATCH_SIZE=200
CYCLE_INTERVAL=60

# theporndb.net API key
THEPORNDB_API_KEY=
TPDB_REQUESTS_PER_SECOND=1
TPDB_BATCH_SIZE=25
TPDB_CYCLE_INTERVAL=60
